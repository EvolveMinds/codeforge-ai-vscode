# Source (only compiled JS ships)
src/
**/*.ts
tsconfig.json

# Admin-only licence issuing — never ships in any package
out/enterprise/license/licenseGenerator.*

# Internal reports and local deployment drafts — never ship
SECURITY_AUDIT_REPORT*.md
*.stackdump
docker-compose.*.yml
k8s/

# >>> community-only
# Proprietary Enterprise code stays out of the free Marketplace package.
# scripts/package-enterprise.js strips this block to build the Enterprise package.
# The licence checker stays so the Community build can verify keys and trials;
# core/enterpriseGate.ts handles the generators being absent.
out/desktop/**
out/enterprise/**
!out/enterprise/license/licenseTypes.js
!out/enterprise/license/licenseValidator.js
!out/enterprise/license/licenseManager.js
LICENSE-ENTERPRISE
EULA.md
# <<< community-only

# Build scaffolding
build-steps/
build-runner.sh
build-runner.bat
BUILD_PLAN.md

# Dev docs (not needed by end users)
docs/
CLAUDE.md

# Dev config
.claude/
.gitignore
.git/

# Secrets (must never be packaged)
.env
.env.*
.ovsx-token
.vsce-token

# Tests
**/test/
**/*.test.js
**/*.test.js.map
.vscode-test/

# Misc
node_modules/
*.vsix
.DS_Store
Thumbs.db

# Local simulation harnesses
.de1-sim/
.de2-sim/
.de3-sim/
.de4-sim/
.*-sim/
vsixcheck/
evals/
scripts/
dist-desktop/
electron-builder.yml
